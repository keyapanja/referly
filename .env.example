# Copy to .env for docker compose, or set these on your hosting provider.

# Postgres password used by docker compose (the API gets DATABASE_URL from it).
POSTGRES_PASSWORD=change-me

# Public origins. BASE_URL is the API (tracking links live here); WEB_URL is the app.
BASE_URL=https://api.yourdomain.com
WEB_URL=https://app.yourdomain.com

# Hosted API only (not needed with docker compose): full Postgres connection string.
# DATABASE_URL=postgres://user:password@host:5432/referly

# Email: console | resend | smtp
EMAIL_PROVIDER=console
EMAIL_FROM="Your Business <no-reply@yourdomain.com>"
# RESEND_API_KEY=re_...
# SMTP_URL=smtp://user:password@smtp.yourdomain.com:587

# Platform admin (created on boot if missing) and the address merchants contact for plan changes
PLATFORM_ADMIN_EMAIL=admin@yourdomain.com
PLATFORM_ADMIN_PASSWORD=change-me-too
PLATFORM_SUPPORT_EMAIL=support@yourdomain.com

# Uploaded asset files: local (served by the API from FILES_DIR) | s3 (any S3-compatible bucket)
STORAGE_PROVIDER=local
# S3_BUCKET=referly-assets
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://assets.yourdomain.com
# S3_FORCE_PATH_STYLE=true
